  <worksheets>
    <worksheet name=' KPI 1'>
      <table>
        <view>
          <datasources>
            <datasource caption='Fact_Orders+ (logistics dataset)' name='federated.0lxft121d5ys0a111y1sn1133n0m' />
          </datasources>
          <datasource-dependencies datasource='federated.0lxft121d5ys0a111y1sn1133n0m'>
            <column caption='Total_Orders' datatype='integer' name='[Calculation_0412110090633216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Order_ID])' />
            </column>
            <column caption='Total_Profit' datatype='real' name='[Calculation_0412110090895362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])' />
            </column>
            <column caption='Avg_Delivery_Time Hour' datatype='real' name='[Calculation_0412110091038723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Delivery_Time_Hours])' />
            </column>
            <column caption='On-Time Delivery %' datatype='real' default-format='p0.00%' name='[Calculation_0412110091272196]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [Delivery_Status] = &quot;On Time&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/ COUNT([Order_ID]) * 100' />
            </column>
            <column caption='Delivery Status' datatype='string' name='[Delivery_Status]' role='dimension' type='nominal' />
